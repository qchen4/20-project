// Description  : 
// 1: i-bus use ahb-lite master interface.
// 2: maximal buffer 3 instructions.
//----------------------------------------------------------------------------//

`include "mrisc_define.vh"

module mrisc_ifetch(
    //instr read bus inf
	i_haddr			,
	i_hburst		,
	i_htrans		,
	i_hsize			,
	i_hprot			,
	i_hwrite		,
	i_hwdata		,
    i_hmastlock     ,
	i_hready		,
	i_hrdata		,
	i_hresp			,    

    //flow ctrl with core pipeline
    dec_pc_halt     ,
    exe_pc_halt     ,
    exe_pc_update   ,
    exe_pc_opd0     ,
    exe_pc_opd1     ,

    exe_wait_trap   ,
    wb_wait_trap    ,
    irq_wait_trap   ,

    //core pipe stage flags
    dec_vld         ,
    exe_vld         ,
    d_aph_vld       ,

    //CSR and intr inf
    trap_req        ,
    trap_ack        ,
    i_go_trap       ,
    cpu_idle        ,
    csr_mtvec       ,
    csr_mcause      ,
    pc              ,

    //ifetch handshake inf
    if_vld          ,
    if_ack          ,
    if_pc           ,
    if_code         ,
    if_c_resp       ,

    clk             ,
    rstn             
);


input   wire            clk, rstn       ;
//instr read ahb-lite bus inf
output  wire	[31:0]	i_haddr		    ;
output  wire	[2:0]	i_hburst	    ;
output  wire	[1:0]	i_htrans	    ;
output  wire	[2:0]	i_hsize		    ;
output  wire	[3:0]	i_hprot		    ;
output  wire		    i_hwrite	    ;
output  wire	[31:0]	i_hwdata	    ;
output  wire            i_hmastlock     ;
input   wire            i_hready        ;
input   wire    [31:0]  i_hrdata        ;
input   wire            i_hresp         ;   //0:okay; 1:error

//flow ctrl with core pipeline
input   wire            dec_pc_halt     ;   //dec stage detect not pc+4, indicate pc will jump, this signal maybe missed
input   wire            exe_pc_halt     ;   //exe stage detect not pc+4, indicate pc will jump, this signal maybe missed
input   wire            exe_pc_update   ;   //exe stage pc branched(branch/jal/jalr/mret/wfi), 1T pulse, can't miss this signal
input   wire    [31:0]  exe_pc_opd0     ;   //opd0 to cal new PC, keep stable until pc update ended
input   wire    [20:0]  exe_pc_opd1     ;   //opd1 to cal new PC, keep stable until pc update ended
input   wire            exe_wait_trap   ;   //exe stage detect sync exception or wfi, 1T pulse
input   wire            wb_wait_trap    ;   //wb stage detect sync exception, 1T pulse
input   wire            irq_wait_trap   ;   //async interrupt is pending, level active, may change from 1 -> 0 at any time.

//core pipe stage flags
input   wire            dec_vld         ;   //valid output at dec stage
input   wire            exe_vld         ;   //valid output at exe stage
input   wire            d_aph_vld       ;   //valid output at d_aph stage

//CSR and intr inf
input   wire            trap_req        ;   //trap req, high level active; must keep 1'b1 until trap_ack=1
output  wire            trap_ack        ;   //== cpu_idle
output  wire            i_go_trap       ;   //1T pulse, the next cycle, pc change to trap begin addr.
                                            //when 1'b1, i-bus and all pipe stages are in idle state, d-bus may working.
output  wire            cpu_idle        ;   //from ifetch to write back stage and i-bus are all idle, d-bus may working.
input   wire    [31:0]  csr_mtvec       ;   //trap begin address
input   wire    [31:0]  csr_mcause      ;   //{intr, cause}
output  reg     [31:0]  pc              ;   //i-bus read PC value

//ifetch handshake inf
output  wire            if_vld          ;   //instruction code valid; if_vld may change from 1'b1
                                            //to 1'b0 when if_ack=0
input   wire            if_ack          ;   //instruction code accepted
output  wire    [31:0]  if_pc           ;   //pc of this code
output  wire    [31:0]  if_code         ;   //instruction code
output  wire            if_c_resp       ;   //instruction resp: 0: okay,  1: error


