`endprotected128


//---3: ahb-lite interface
assign  i_haddr     = {pc[31:2], 2'h0};
assign  i_hburst    = 3'h0;                     //single
assign  i_htrans    = (i_areq)? 2'b10 : 2'b00;  //nonseq : idle
assign  i_hsize     = 3'b010;                   //32bit
assign  i_hprot     = 4'b1110;                  //cacheable, bufferable, privileged, opcode
assign  i_hwrite    = 1'b0;
assign  i_hwdata    = 32'h0;
assign  i_hmastlock = 1'b0;

endmodule

