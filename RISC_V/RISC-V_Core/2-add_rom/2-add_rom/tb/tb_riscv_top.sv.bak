module tb_riscv_top;

parameter	FILE      = "rv32ui-p-addi.txt"	;
parameter	AW				=	32											;
parameter	DW				=	32											;

logic       				clk												;
logic       				rst_n											;


riscv #(
	.FILE							(FILE											),
	.AW								(AW												),	
	.DW								(DW												)
	)u_riscv_inst(                                			
	.clk							(clk											),
  .rst_n						(rst_n										)
);     
	
	
always #5 clk = ~clk;	
initial begin
	clk     					= 1'b0;
	rst_n   					= 1'b0; 
	#1000;          	
	rst_n   					= 1'b1;
end


     
endmodule

