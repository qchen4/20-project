add_test(NAME system_properties COMMAND bppe_system_tests)
set(system_fixture "${CMAKE_CURRENT_SOURCE_DIR}/tests/system_fixtures/good.mem")
add_test(NAME system_vector_fixture COMMAND bppe_check_system_vectors "${system_fixture}")
if(BPPE_SYSTEM_VECTORS)
    if(NOT EXISTS "${BPPE_SYSTEM_VECTORS}")
        message(FATAL_ERROR "Export MATLAB system vectors first")
    endif()
    add_test(NAME matlab_system_vectors COMMAND bppe_check_system_vectors "${BPPE_SYSTEM_VECTORS}")
endif()
file(STRINGS "${system_fixture}" system_rows)
function(system_negative name row field value expected)
    list(GET system_rows ${row} original)
    string(REPLACE " " ";" fields "${original}")
    list(REMOVE_AT fields ${field})
    list(INSERT fields ${field} "${value}")
    list(JOIN fields " " modified)
    set(rows ${system_rows})
    list(REMOVE_AT rows ${row})
    list(INSERT rows ${row} "${modified}")
    list(JOIN rows "\n" content)
    set(path "${CMAKE_CURRENT_BINARY_DIR}/reject_system_${name}.mem")
    file(WRITE "${path}" "${content}\n")
    add_test(NAME rejects_system_${name} COMMAND "${CMAKE_COMMAND}"
        "-DCHECKER=$<TARGET_FILE:bppe_check_system_vectors>" "-DVECTORS=${path}"
        "-DEXPECTED=${expected}" -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/assert_system_rejected.cmake")
endfunction()
