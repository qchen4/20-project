add_test(NAME frame_properties COMMAND bppe_frame_tests)
set(frame_fixture "${CMAKE_CURRENT_SOURCE_DIR}/tests/frame_fixtures/good.mem")
add_test(NAME frame_vector_fixture COMMAND bppe_check_frame_vectors "${frame_fixture}")
if(BPPE_FRAME_VECTORS)
    if(NOT EXISTS "${BPPE_FRAME_VECTORS}")
        message(FATAL_ERROR "Export MATLAB frame vectors first")
    endif()
    add_test(NAME matlab_acquisition_vectors COMMAND bppe_check_frame_vectors "${BPPE_FRAME_VECTORS}")
endif()
file(STRINGS "${frame_fixture}" frame_rows)
list(GET frame_rows 0 frame_first)
list(GET frame_rows 1 frame_second)
function(frame_negative name field value expected)
    string(REPLACE " " ";" fields "${frame_second}")
    list(REMOVE_AT fields ${field})
    list(INSERT fields ${field} "${value}")
    list(JOIN fields " " modified)
    set(path "${CMAKE_CURRENT_BINARY_DIR}/reject_frame_${name}.mem")
    file(WRITE "${path}" "${frame_first}\n${modified}\n")
    add_test(NAME rejects_frame_${name} COMMAND "${CMAKE_COMMAND}"
        "-DCHECKER=$<TARGET_FILE:bppe_check_frame_vectors>" "-DVECTORS=${path}"
        "-DEXPECTED=${expected}" -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/assert_frame_rejected.cmake")
endfunction()
frame_negative(decision 28 0000000000000000 "frame decision/fault mismatch")
frame_negative(sticky_fault 30 0000000000000008 "frame decision/fault mismatch")
frame_negative(elapsed 31 000000000000000B "frame elapsed mismatch")
frame_negative(signed_tick 32 FFFFFFFFFFFFFFFF "accepted channel tick mismatch")
frame_negative(history 35 00000000000186A1 "acquisition channel history mismatch")
frame_negative(beat_valid 50 0000000000000001 "acquisition beat-valid mismatch")
frame_negative(numeric_fault 73 0000000000000001 "acquisition numeric fault mismatch")
frame_negative(order 1 0000000000000003 "frame configuration/order changed")
frame_negative(config 4 0000000000000009 "frame configuration/order changed")
frame_negative(adc_domain 22 0000000001000000 "frame field outside domain")
frame_negative(boolean 28 0000000000000002 "frame field outside domain")
frame_negative(hex 22 X0000000000186A0 "invalid hexadecimal frame field")
set(frame_truncated "${CMAKE_CURRENT_BINARY_DIR}/reject_frame_truncated.mem")
file(WRITE "${frame_truncated}" "${frame_first}\n0000000000000001\n")
add_test(NAME rejects_frame_truncated COMMAND "${CMAKE_COMMAND}"
    "-DCHECKER=$<TARGET_FILE:bppe_check_frame_vectors>" "-DVECTORS=${frame_truncated}"
    "-DEXPECTED=expected 74 hexadecimal frame fields" -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/assert_frame_rejected.cmake")
