execute_process(COMMAND "${CHECKER}" "${VECTORS}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${status}" STREQUAL "1")
    message(FATAL_ERROR "Checker must exit 1 for ${EXPECTED}; actual=${status}\n${out}\n${err}")
endif()
string(FIND "${err}" "${EXPECTED}" found)
if(found LESS 0 OR out MATCHES "ACQUISITION_MATLAB_VECTORS_PASSED")
    message(FATAL_ERROR "Wrong rejection: expected ${EXPECTED}\n${out}\n${err}")
endif()
message(STATUS "EXPECTED_FRAME_REJECTION ${EXPECTED}")
