//just a space holder to provide the start_item, finish_item functions
class apb_mas_passthru_seq extends uvm_sequence #(amiq_apb_master_drv_item);

    `uvm_object_utils(apb_mas_passthru_seq)

    function new(string name = "apb_mas_passthry_seq");
        super.new(name);
    endfunction

endclass : apb_mas_passthru_seq


class cdma_cmd_driver extends uvm_driver #(.REQ(dma_cmd_group), .RSP(dma_cmd_resp));
    uvm_event_pool              events  ;
    uvm_event                   dma_2d_begin_event;
    tvip_axi_slv_vif            axi_vif ;   //set through config_db
    cdma_misc_vif               cdma_vif;   //set through config_db
    apb_mas_passthru_seq        apb_seq;
    amiq_apb_sequencer#(amiq_apb_master_drv_item) apb_base_sqr;
    amiq_apb_master_sequencer   apb_sqr;    //pointer only, pass in before use
    dma_cmd_resp    resp    ;
    uvm_analysis_port#(dma_cmd_group) cmd_group_port;

    dma_env_ctl     env_ctl ;   //pointer only, set through uvm_config_db::get
    bit [15:0]      cmd_num;
    uint64          cmds_end_cyc;

    `uvm_component_utils(cdma_cmd_driver)

