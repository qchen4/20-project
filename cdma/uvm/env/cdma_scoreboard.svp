`uvm_analysis_imp_decl(_cmd)
`uvm_analysis_imp_decl(_axi)

class cdma_scoreboard extends uvm_scoreboard;

    `uvm_component_utils(cdma_scoreboard);
    int             cmds_cnt = 0;
    dma_cmd_group   recv_cmd_group;         //pointer only
    dma_env_ctl     env_ctl     ;           //pointer only
    sky_sys_mem #(.A_WIDTH(32)) ref_mem;
    tvip_axi_slv_vif            axi_vif;

    uvm_analysis_imp_cmd #(dma_cmd_group, cdma_scoreboard)   cmd_group_imp;
    uvm_analysis_imp_axi #(tvip_axi_item, cdma_scoreboard)   axi_mon_imp;

    uvm_event_pool      events;
    uvm_event           dma_2d_begin_event;
    //dma cmd beat check queue
    longint             cmd_check_beat;
    bus_rw_chk_item     cmd_ref_q[$];
    bus_rw_chk_item     cmd_dut_q[$];

    //axi read beat check queue
    longint             axir_check_beat;
    bus_rw_chk_item     axir_ref_q[$];
    bus_rw_chk_item     axir_dut_q[$];
    bit[7:0]            axir_data_q[$];

    //axi write beat check quese
    longint             axiw_check_beat;
    bus_rw_chk_item     axiw_ref_q[$];
    bus_rw_chk_item     axiw_dut_q[$];


    extern virtual function void do_a_cmd(dma_cmd_ctl cmd);
    extern virtual function void chk_mem_data();
    extern virtual task gen_cmd_ref_item();
    extern virtual task gen_rdata_ref_item();
    extern virtual task gen_wdata_ref_item();
    extern virtual function bit chk_beat_item(bus_rw_chk_item golden, bus_rw_chk_item dut);

    `protected128
