endclass : cdma_cmd_coverage


function void cdma_cmd_coverage::cmd_1d_4KB_chk(dma_1d_ctl cmd_1d);
    bit [31:0]  sa_end_addr;    //1D copy include this addr
    bit [31:0]  da_end_addr;    //1D copy include this addr

    sa_end_addr = cmd_1d.sar + cmd_1d.xsize;
    if(sa_end_addr[31:12] != cmd_1d.sar[31:12]) begin
        cmd_1d.sa_cross_4kb     = 1;
        cmd_1d.sa_byte_len_seg0 = 32'd4095 - cmd_1d.sar[11:0];                  //cnt from 0
        cmd_1d.sa_byte_len_seg1 = cmd_1d.xsize - cmd_1d.sa_byte_len_seg0 - 'd1; //cnt from 0
    end else begin
        cmd_1d.sa_cross_4kb     = 0;
        cmd_1d.sa_byte_len_seg0 = cmd_1d.xsize;   //cnt from 0
        cmd_1d.sa_byte_len_seg1 = 0;

    end

    da_end_addr = cmd_1d.dar + cmd_1d.xsize;
    if(da_end_addr[31:12] != cmd_1d.dar[31:12]) begin
        cmd_1d.da_cross_4kb     = 1;
        cmd_1d.da_byte_len_seg0 = 32'd4095 - cmd_1d.dar[11:0];                  //cnt from 0
        cmd_1d.da_byte_len_seg1 = cmd_1d.xsize - cmd_1d.da_byte_len_seg0 - 'd1; //cnt from 0
    end else begin
        cmd_1d.da_cross_4kb     = 0;
        cmd_1d.da_byte_len_seg0 = cmd_1d.xsize;   //cnt from 0
        cmd_1d.da_byte_len_seg1 = 0;
    end

endfunction

