'    assign  cache_line_wr   = tb.u_icache_ahb.u_icache_dmem.cache_line_wr;',
'',
'    assign  dut_mon_sig = {28\'h0,',
'                           1\'h0, cache_line_wr, m_wrap_dphase, cache_init};',
'    ',
'    assign  dut_mon.hit_chk_point= tb.u_icache_ahb.u_icache_tag.hit_chk_point;',
'    assign  dut_mon.tag_info_used= tb.u_icache_ahb.u_icache_tag.tag_info_used;',
'    assign  dut_mon.chk_haddr_d  = tb.u_icache_ahb.u_icache_tag.chk_haddr_d;',
'    assign  dut_mon.w0_hit       = tb.u_icache_ahb.u_icache_tag.w0_hit;',
