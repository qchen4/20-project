'	//--- upstream ahb-lite slave interface',
'	.s_hsel			(1\'b1           ),',
'	.s_haddr		(m_ahb.haddr	),',
'	.s_hburst		(m_ahb.hburst	),',
'	.s_htrans		(m_ahb.htrans	),',
'	.s_hsize		(m_ahb.hsize	),',
'	.s_hprot		(m_ahb.hprot	),',
'	.s_hwrite		(m_ahb.hwrite	),',
'	.s_hwdata		(m_ahb.hwdata	),',
