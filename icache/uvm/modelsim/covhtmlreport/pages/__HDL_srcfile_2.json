'    yuu_ahb_master_interface  m_ahb(.dut_mon(dut_mon_sig));',
'    yuu_ahb_slave_interface   s_ahb();',
'',
'    //DUT internal signal monitor infterface',
'    i_cache_monitor_interface dut_mon(.clk(clk), .rstn(rstn));',
'',
