// 文件说明 i_cache_scb.svp
// I-Cache Scoreboard 与参考模型，连接两侧事务、内部状态和功能覆盖率。
// 公开声明保存实际/预测下游事务、模型内存、缓存状态和标签比较队列。
// 参考模型处理与比较方法体位于 protected128 段，仅能从公开声明确认其职责。
// report_phase 检查指定队列残留并根据本地 err 打印结果；全局 UVM 错误还需另行核对。

`include "sim_define.v"

`uvm_analysis_imp_decl(_mas)
`uvm_analysis_imp_decl(_slv)
`uvm_analysis_imp_decl(_dut_sta)

class i_cache_scb extends uvm_scoreboard;

    `uvm_component_utils(i_cache_scb)
    //ahb trans from monitor in ahb master agent
    uvm_analysis_imp_mas #(yuu_ahb_item, i_cache_scb)   mas2scb;
    //ahb trans from monitor in ahb slave agent
    uvm_analysis_imp_slv #(yuu_ahb_item, i_cache_scb)   slv2scb;
    //dut internal status monitor
    uvm_analysis_imp_dut_sta #(i_cache_dut_status, i_cache_scb)   dutsta2scb;

    //send item for function coverage
    uvm_analysis_port #(i_cache_coverage_item)          scb2cov;

    //DUT internal and IO signals
    i_cache_misc_vif    misc_vif;
    //ahb trans item send out from m-ahb monitor(monitor in ahb-lite master agent)
    yuu_ahb_master_item m_ahb_q [$];
    //dut status, align with cmd phase of m-ahb valid trans
    i_cache_dut_status  dut_status_q[$];

    //ahb trans item send out from DUT
    yuu_ahb_item    s_ahb_q [$];        //s-ahb agent(ahb-lite slave agent) monitored ahb trans
    //ahb trans item generated by i-cache reference model
    yuu_ahb_item    ref_s_ahb_q [$];    //reference model generate s-ahb trans
    //i-cache tag/data mem and control info used by reference model
    icache_ctl_t    cache_ctl;

    //tag info and hit check result of each cacheable instr read trans(used to simple debug effort)
    i_cache_dut_mon_item    dut_tag_used_q[$];  //tag info used by DUT
    i_cache_dut_mon_item    ref_tag_used_q[$];  //tag info used by ref model

    //delay tag mem update when cache miss in reference model, same behavior as DUT
    icache_tag_update_t     tag_update_q[$];    //ref model tag mem update info when cache miss

    int     err = 0;
    logic   [7:0]   mem [`SIM_SYS_MEM_BEG : `SIM_SYS_MEM_END];  //system memory(mirroed) in ref model

    function new(string name = "inst", uvm_component parent = null);
        super.new(name, parent);
    endfunction

    virtual function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        mas2scb = new("mas2scb", this);
        slv2scb = new("slv2scb", this);
        dutsta2scb= new("dutsta2scb", this);
        scb2cov = new("scb2cov", this);
    endfunction : build_phase

    virtual function void connect_phase(uvm_phase phase);
        super.connect_phase(phase);

        if(!uvm_config_db#(i_cache_misc_vif)::get(null, get_full_name(), "misc_vif", misc_vif)) begin
            err++;
            `uvm_error(get_name(), "uvm_config_db::get DUT monitor virtual interface fail.")
        end
    endfunction : connect_phase

    //m-ahb analysis port write function, trigger the i-cache function in scb
    extern virtual function void write_mas (yuu_ahb_item ahb_item);

    //s-ahb analysis port write function, save the trans for trans item compare
    extern virtual function void write_slv (yuu_ahb_item item);

    //dut monitor analysis port write function
    extern virtual function void write_dut_sta (i_cache_dut_status dut_status);

    //initial tag mem to all 0's
    extern virtual function void icache_init();

    //i-cache function in scb(reference model)
    extern virtual task icache_proc();

    //delay tag mem update when cache miss in reference model, same behavior as DUT
    extern virtual task tag_update_miss();

    //user defined ahb trans item compare function, just compare cared member variables
    extern virtual function bit  ahb_item_compare(yuu_ahb_item i0, yuu_ahb_item i1);

    //UVM build-in run_phase of a component
    extern task run_phase (uvm_phase phase);

    //capture each cache hit check info and result in DUT
    extern virtual task mon_dut();

    //compare the cache hit chekc info and result of DUT and reference model(used to simple debug effort)
    extern virtual task tag_chk_cmp();

    //before $finish(), report sim result
// 公开的结束检查覆盖下游事务及标签相关队列。
// 本地 err 为零才打印 PASS，但其他组件的 UVM_ERROR 不会自动等价于此计数。
    virtual function void report_phase(uvm_phase phase);
        if((s_ahb_q.size() !=0) || (ref_s_ahb_q.size() != 0) || (tag_update_q.size() != 0)) begin
            err++;
            `uvm_error("i_cache_scb::report_phase", "s_ahb_q or ref_s_ahb_q or tag_update_q is not empty.")
        end

        if((dut_tag_used_q.size() !=0) || (ref_tag_used_q.size() !=0)) begin
            err++;
            `uvm_error("i_cache_scb::report_phase", "dut_tag_used_q or ref_tag_used_q is not empty.")
        end

        `uvm_info("i_cache_scb", $sformatf("Sim trans with %0d fail.", err), UVM_LOW);
        if(err == 0)
            $display("SIM PASS!!!");
        else
            $display("SIM FAIL!!!");
    endfunction : report_phase    

endclass : i_cache_scb


