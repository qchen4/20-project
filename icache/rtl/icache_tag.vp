// 文件说明 icache_tag.vp
// I-Cache 标签、有效位、填充命中与替换路管理模块。
// 由 icache_ahb 实例化，并通过独立读写端口访问标签 SRAM。
// 公开说明采用树形伪 LRU；hit_way 是四位独热命中编码，replace_way 是两位路号。
// tag_mem_chk 发起查询；hit_chk_point 标记下一拍结果；tag_mem_wr_miss 通知填充提交。
// 本文件被 flist_dut.f 编译。protected128 区域是受保护实现，不对其内部行为添加推测注释。

//----------------------------------------------------------------------------//
// File name    : icache_tag.v
// Author       : sky@siliconthink.cn
// E-mail       : 
// Project      : 
// Created      : 
// Copyright    : 
// Description  : 
// 1: manage tag addr, vld flag, rlu flag;
// 2: use tree-based pseudo-LRU replacement algorithm. Reference info:
//    https://zhuanlan.zhihu.com/p/516582856
//
//----------------------------------------------------------------------------//

module icache_tag(
    disable_clr_tag ,
    cache_init      ,
    //tag mem ctrl
    tag_mem_chk     ,
    chk_haddr       ,
    hit_chk_point   ,
    tag_hit         ,
    fill_hit        ,
    cache_miss      ,
    hit_way         ,
    hit_offset      ,
    tag_mem_wr_miss ,
    m_wrap_dphase   ,

    //cache data mem replace
    replace_way     ,
    replace_addr    ,

    //tag two-port sram io
    tag_sram_rd     ,
    tag_sram_raddr  ,
    tag_sram_dout   ,
    tag_sram_wdata  ,
    tag_sram_wr     ,
    tag_sram_waddr  ,

    clk             ,
    rstn             
);

//changeabel parameter
parameter   index_bits  = 6;    //4KB 4-way set associated icache(each way is 1KB)

//fixed parameter
parameter   offset_bits = 4;    //128bit(16B) cache line size
parameter   tag_bits    = 32-offset_bits-index_bits;
parameter   tag_mem_depth = 2**index_bits;
//                              tag addr  vld rlu
parameter   tag_mem_width = (4*tag_bits) + 4 + 3;


input   wire            clk, rstn       ;
input   wire            disable_clr_tag ;
input   wire            tag_mem_chk     ;   //tag mem lookup
input   wire    [31:0]  chk_haddr       ;   //haddr to look in tag
output  reg             cache_init      ;
output  wire            hit_chk_point   ;   //1T pulse, 1T delay of tag_mem_chk
output  wire            tag_hit         ;   //hit data in cache mem, valid 1T after tag_mem_chk
output  wire            fill_hit        ;   //1: hit data that is cache line filling, high level active when&after hit_chk_point=1
output  wire            cache_miss      ;   //miss in both tag mem check and fill line check
output  wire    [3:0]   hit_way         ;   //one-hot way id
output  wire    [offset_bits-1-2 : 0] hit_offset;   //32bit offset within a cache line, for both tag hit and fill hit
input   wire            tag_mem_wr_miss ;   //1T delay of cache line mem write
input   wire            m_wrap_dphase   ;   //1: m-ahb data phase of cache line read

output  reg     [1:0]                   replace_way     ;   //whem miss, way ID to store new data
output  wire    [index_bits-1 :0]       replace_addr    ;   //index of way to store new data

output  wire                            tag_sram_rd     ;
output  wire    [index_bits-1 :0]       tag_sram_raddr  ;
input   wire    [tag_mem_width-1 : 0]   tag_sram_dout   ;
output  wire    [tag_mem_width-1 : 0]   tag_sram_wdata  ;
output  wire                            tag_sram_wr     ;
output  wire    [index_bits-1 :0]       tag_sram_waddr  ;


// 以下为受保护的标签控制实现；上方公开端口可供阅读，保护段必须完整保留。
